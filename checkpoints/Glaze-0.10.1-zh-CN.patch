diff --git a/test/webview_js/specs/ui_locale.spec.js b/test/webview_js/specs/ui_locale.spec.js
new file mode 100644
index 00000000..b353db66
--- /dev/null
+++ b/test/webview_js/specs/ui_locale.spec.js
@@ -0,0 +1,34 @@
+import { test, expect } from '@playwright/test';
+import { openHarness, render } from './harness.js';
+
+test('live locale updates app chrome without rewriting messages, editors or scripts', async ({ page }) => {
+  await openHarness(page);
+  await render(page, '<div id="user-content" title="Save" data-ui-i18n="save">Save Cancel Reasoning</div><script>window.localeScriptRuns=(window.localeScriptRuns||0)+1</script>');
+  const result = await page.evaluate(async () => {
+    const { Renderer } = await import('/assets/chat_webview/renderer/message_renderer.js');
+    const { Formatter } = await import('/assets/chat_webview/formatter/index.js');
+    const { Bridge } = await import('/assets/chat_webview/bridge/chat_bridge_controller.js');
+    const renderer = new Renderer(new Formatter(), null);
+    const buttons = renderer._createEditButtons('m1');
+    document.body.append(buttons);
+    const body = window.harness.currentRoot();
+    const original = body.innerHTML;
+    const userNode = body.querySelector('#user-content');
+    const editor = document.createElement('textarea');
+    editor.value = 'Save 用户输入';
+    editor.setSelectionRange(2, 4);
+    document.body.append(editor);
+    const runs = window.localeScriptRuns;
+    Bridge.prototype.setUiLocale.call(window.bridge, 'zh-CN');
+    const chinese = buttons.querySelector('.save').title;
+    Bridge.prototype.setUiLocale.call(window.bridge, 'ru');
+    const russian = buttons.querySelector('.save').title;
+    Bridge.prototype.setUiLocale.call(window.bridge, 'unrecognized');
+    return { chinese, russian, english: buttons.querySelector('.save').title,
+      sameDOM: body.innerHTML === original && body.querySelector('#user-content') === userNode,
+      value: editor.value, selection: [editor.selectionStart, editor.selectionEnd],
+      scriptUnchanged: runs === window.localeScriptRuns };
+  });
+  expect(result).toEqual({ chinese: '保存', russian: 'Сохранить', english: 'Save', sameDOM: true,
+    value: 'Save 用户输入', selection: [2, 4], scriptUnchanged: true });
+});
