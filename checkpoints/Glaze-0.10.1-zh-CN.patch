diff --git a/.github/workflows/build-zh-recovery.yml b/.github/workflows/build-zh-recovery.yml
new file mode 100644
index 00000000..9db3505f
--- /dev/null
+++ b/.github/workflows/build-zh-recovery.yml
@@ -0,0 +1,41 @@
+name: Build Chinese Android recovery
+on:
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  build:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 60
+    env:
+      CI: 'true'
+      FLUTTER_SUPPRESS_ANALYTICS: 'true'
+      BUILD_CHANNEL: stable
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '21'
+      - uses: android-actions/setup-android@v3
+        with:
+          packages: platform-tools
+          log-accepted-android-sdk-licenses: false
+      - name: Install pinned Flutter
+        run: |
+          git clone --depth 1 --branch 3.44.9 https://github.com/flutter/flutter.git "$RUNNER_TEMP/flutter"
+          echo "$RUNNER_TEMP/flutter/bin" >> "$GITHUB_PATH"
+          "$RUNNER_TEMP/flutter/bin/flutter" --version
+      - run: cp .env.example .env
+      - run: flutter pub get
+      - run: dart run build_runner build
+      - run: dart run easy_localization:generate -S assets/translations -s en.json -f keys -o locale_keys.g.dart
+      - run: python3 scripts/check_zh_localization.py
+      - run: flutter analyze --no-fatal-infos --no-fatal-warnings
+      - run: flutter test --concurrency=2 --reporter expanded
+      - run: flutter build apk --release --target-platform android-arm64 --split-per-abi --dart-define=BUILD_CHANNEL=stable
+      - uses: actions/upload-artifact@v4
+        with:
+          name: Glaze-0.9.0-zh-CN-arm64-test-signed
+          path: build/app/outputs/flutter-apk/*.apk
+          if-no-files-found: error
