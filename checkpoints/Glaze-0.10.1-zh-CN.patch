+  zh: {save:'保存',cancel:'取消',copy:'复制',reasoning:'推理',regenerate:'重新生成',retryImage:'↻ 重新生成',options:'选项',previous:'上一个',next:'下一个',previousImage:'上一张图片',nextImage:'下一张图片',imageGenerating:'正在生成图片…',imageQueued:'图片排队中…',stopImage:'停止图片生成',guided:'引导切换回复',guidedHeader:'引导切换回复',guidedHint:'输入切换回复的 OOC 指令…',confirm:'确认',translate:'翻译',cleaner:'重新运行后处理润色器',hiddenImage:'对模型隐藏',visibleImage:'发送给模型'},
+};
+let locale = 'en';
+const nodes = new Set();
+const bindings = new WeakMap();
+const templates = new Map();
+const prefix = Math.random().toString(36).slice(2);
+let serial = 0;
+export function uiText(key) { return dictionaries[locale][key] ?? dictionaries.en[key] ?? key; }
+function apply(node, property, key) {
+  const text = uiText(key);
+  node[property] = text;
+  if (property === 'title') node.setAttribute('aria-label', text);
+}
+export function bindUi(node, key, property = 'textContent') {
+  let fields = bindings.get(node);
+  if (!fields) { fields = new Map(); bindings.set(node, fields); nodes.add(new WeakRef(node)); }
+  fields.set(property, key);
+  apply(node, property, key);
+  return node;
+}
+export function setUiLocale(value) {
+  const language = String(value || '').toLowerCase().split(/[-_]/)[0];
+  locale = Object.hasOwn(dictionaries, language) ? language : 'en';
+  for (const ref of nodes) {
+    const node = ref.deref();
+    if (!node) { nodes.delete(ref); continue; }
+    for (const [property, key] of bindings.get(node)) apply(node, property, key);
+  }
+}
+// Opaque template tokens identify only markup emitted by our own formatter.
+// They are not translation keys and arbitrary user data attributes do not bind.
+export function uiAttrs(key, property = 'title') {
+  const token = `${prefix}-${++serial}`;
+  templates.set(token, { key, property });
+  const attribute = property === 'textContent' ? '' : ` ${property}="${uiText(key)}"`;
+  return `data-glaze-ui="${token}"${attribute}`;
+}
+export function uiSpan(key) { return `<span ${uiAttrs(key, 'textContent')}>${uiText(key)}</span>`; }
+export function hydrateUi(root) {
+  for (const node of root.querySelectorAll('[data-glaze-ui]')) {
+    const binding = templates.get(node.getAttribute('data-glaze-ui'));
+    if (binding) bindUi(node, binding.key, binding.property);
+  }
+}
