diff --git a/scripts/check_zh_localization.py b/scripts/check_zh_localization.py
new file mode 100644
index 00000000..6fff1514
--- /dev/null
+++ b/scripts/check_zh_localization.py
@@ -0,0 +1,37 @@
+#!/usr/bin/env python3
+import json,re,collections,pathlib,hashlib
+ROOT=pathlib.Path(__file__).resolve().parents[1]
+def unique(pairs):
+ d={}
+ for k,v in pairs:
+  assert k not in d, 'duplicate key: '+k
+  d[k]=v
+ return d
+def read(p):return json.loads(p.read_text(),object_pairs_hook=unique)
+def flat(d,p=''):
+ if isinstance(d,dict):
+  for k,v in d.items():yield from flat(v,p+'.'+k)
+ elif isinstance(d,list):
+  for i,v in enumerate(d):yield from flat(v,p+f'[{i}]')
+ else:yield p,d
+TOKEN=re.compile(r'\{\{[^{}]*\}\}|\$\{[^{}]*\}|(?<!\{)\{[\w.]*\}(?!\})|%(?:\d+\$)?[-+0#]*\d*(?:\.\d+)?[sdif]|https?://[A-Za-z0-9._~:/?#\[\]@!$&*+,;=%-]+')
+def main():
+ t=ROOT/'assets/translations';en=read(t/'en.json');zh=read(t/'zh.json');e=dict(flat(en));z=dict(flat(zh))
+ assert e.keys()==z.keys(),f'missing={e.keys()-z.keys()}, extra={z.keys()-e.keys()}'
+ for k,v in e.items():
+  assert type(v)==type(z[k]),k
+  if isinstance(v,str):
+   assert z[k].strip(),k
+   assert collections.Counter(TOKEN.findall(v))==collections.Counter(TOKEN.findall(z[k])),k+' placeholders/URLs'
+ contract=read(ROOT/'localization/upstream-contract.json')
+ for lang,base in contract.items():
+  current=read(t/f'{lang}.json');subset={k:current[k] for k in base['keys']}
+  digest=hashlib.sha256(json.dumps(subset,ensure_ascii=False,sort_keys=True,separators=(',',':')).encode()).hexdigest()
+  assert digest==base['sha256'],lang+' original resources changed'
+ ge=dict(flat(read(t/'glossary_en.json')));gz=dict(flat(read(t/'glossary_zh.json')))
+ assert ge.keys()==gz.keys(),'glossary structure'
+ for k,v in ge.items():
+  if k.endswith('.id') or not isinstance(v,str):assert gz[k]==v,k
+  elif isinstance(v,str):assert collections.Counter(TOKEN.findall(v))==collections.Counter(TOKEN.findall(gz[k])),k
+ print(f'PASS {len(en)} UI keys, {len(e)} leaf values; placeholders, URLs, duplicates, glossary schema/IDs, original en/ru resources')
+if __name__=='__main__':main()
diff --git a/test/app_language_recovery_test.dart b/test/app_language_recovery_test.dart
new file mode 100644
index 00000000..7a78d9c1
--- /dev/null
+++ b/test/app_language_recovery_test.dart
@@ -0,0 +1,29 @@
+import 'dart:ui';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:glaze_flutter/core/constants/app_languages.dart';
+import 'package:glaze_flutter/features/settings/app_locale_preferences.dart';
+import 'package:glaze_flutter/features/settings/app_settings_provider.dart';
+void main() {
+ test('system locale resolves Chinese regions, Russian and unsupported locale', () {
+  expect(resolveAppLocale('system',const Locale('zh','CN')),const Locale('zh'));
+  expect(resolveAppLocale('system',const Locale('ru','RU')),const Locale('ru'));
+  expect(resolveAppLocale('system',const Locale('ja')),const Locale('en'));
+  expect(resolveAppLocale('en',const Locale('zh')),const Locale('en'));
+ });
+ test('explicit preference outranks legacy locale cache', () async {
+  SharedPreferences.setMockInitialValues({'language':'zh','locale':'ru'});
+  final p=await SharedPreferences.getInstance();
+  expect(await prepareAppLocale(p,const Locale('en')),const Locale('zh'));
+  expect(p.containsKey('locale'),false);expect(p.getString('language'),'zh');
+ });
+ test('legacy-only selection migrates and choices persist', () async {
+  SharedPreferences.setMockInitialValues({'locale':'ru_RU'});
+  final p=await SharedPreferences.getInstance();
+  expect(await prepareAppLocale(p,const Locale('zh')),const Locale('ru'));
+  for(final language in ['system','zh','en','ru']) {
+   await AppSettingsPreferences.write(p,AppSettings(language:language));
+   expect(AppSettingsPreferences.read(p).language,language);
+  }
+ });
+}
diff --git a/test/bundled_text_localization_test.dart b/test/bundled_text_localization_test.dart
new file mode 100644
index 00000000..fec54016
--- /dev/null
+++ b/test/bundled_text_localization_test.dart
@@ -0,0 +1,90 @@
+import 'package:easy_localization/easy_localization.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+import 'package:glaze_flutter/core/localization/bundled_text.dart';
+import 'package:glaze_flutter/shared/widgets/generic_editor.dart';
+
+class _TestLoader extends AssetLoader {
+  const _TestLoader();
+  @override
+  Future<Map<String, dynamic>> load(String path, Locale locale) async => {
+    'glaze_bundled_locale': locale.languageCode,
+  };
+}
+
+void main() {
+  const original =
+      "Write {{char}}'s next reply in a fictional chat between {{char}} and {{user}}.";
+  const chinese = '在 {{char}} 与 {{user}} 的虚构对话中，撰写 {{char}} 的下一条回复。';
+
+  test('factory text is translated only in Chinese', () {
+    expect(bundledTextInLanguage(original, 'zh'), chinese);
+    expect(bundledTextInLanguage(original, 'en'), original);
+    expect(bundledTextInLanguage(original, 'ru'), original);
+    expect(bundledTextInLanguage('my custom prompt {{user}}', 'zh'),
+        'my custom prompt {{user}}');
+  });
+
+  test('display translation does not replace an unedited original', () {
+    expect(preserveUneditedBundledText(original, chinese, chinese), original);
+    expect(preserveUneditedBundledText(original, chinese, '用户明确修改的内容'),
+        '用户明确修改的内容');
+  });
+
+  testWidgets('preset editor shows Chinese but saves original unedited body',
+      (tester) async {
+    SharedPreferences.setMockInitialValues({});
+    await EasyLocalization.ensureInitialized();
+    Map<String, dynamic>? changed;
+    late BuildContext localeContext;
+    await tester.pumpWidget(ProviderScope(
+      child: EasyLocalization(
+        supportedLocales: const [Locale('zh'), Locale('en')],
+        startLocale: const Locale('zh'),
+        fallbackLocale: const Locale('en'),
+        path: 'test-assets',
+        assetLoader: const _TestLoader(),
+        saveLocale: false,
+        child: Builder(builder: (context) {
+          localeContext = context;
+          return MaterialApp(
+            locale: context.locale,
+            localizationsDelegates: context.localizationDelegates,
+            supportedLocales: context.supportedLocales,
+            home: Scaffold(
+              body: GenericEditor(
+                localizeBundledText: true,
+                item: const {'name': 'Main Prompt', 'content': original},
+                config: const [
+                  GenericEditorSection(fields: [
+                    GenericEditorField(key: 'name', label: '名称'),
+                    GenericEditorField(
+                      key: 'content', label: '内容', type: 'textarea', rows: 3),
+                  ]),
+                ],
+                onChanged: (value) => changed = Map.from(value),
+              ),
+            ),
+          );
+        }),
+      ),
+    ));
+    await tester.pumpAndSettle();
+    expect(find.text('主提示词'), findsOneWidget);
+    expect(find.text(chinese), findsOneWidget);
+    expect(changed, isNull);
+
+    await tester.enterText(find.byType(TextField).first, '我编辑的名称');
+    expect(changed?['content'], original);
+    expect(changed?['name'], '我编辑的名称');
+
+    await localeContext.setLocale(const Locale('en'));
+    await tester.pumpAndSettle();
+    expect(find.text(original), findsOneWidget);
+    expect(changed?['content'], original);
+    expect(tester.takeException(), isNull);
+  });
+}
