diff --git a/lib/core/constants/app_languages.dart b/lib/core/constants/app_languages.dart
new file mode 100644
index 00000000..c1239826
--- /dev/null
+++ b/lib/core/constants/app_languages.dart
@@ -0,0 +1,13 @@
+import 'dart:ui';
+
+const supportedAppLanguages = {'system', 'en', 'ru', 'zh'};
+const supportedAppLocales = [Locale('en'), Locale('ru'), Locale('zh')];
+
+Locale resolveAppLocale(String preference, Locale deviceLocale) {
+  final language = preference == 'system' ? deviceLocale.languageCode : preference;
+  return Locale(switch (language) { 'zh' => 'zh', 'ru' => 'ru', _ => 'en' });
+}
+
+String appLanguageName(String language, {required String systemLabel}) => switch (language) {
+  'zh' => '简体中文', 'ru' => 'Русский', 'en' => 'English', _ => systemLabel,
+};
diff --git a/lib/core/localization/bundled_text.dart b/lib/core/localization/bundled_text.dart
new file mode 100644
index 00000000..420f1948
--- /dev/null
+++ b/lib/core/localization/bundled_text.dart
@@ -0,0 +1,21 @@
+import 'package:easy_localization/easy_localization.dart';
+
+import 'bundled_zh.g.dart';
+
+/// Exact-match display translation for factory-bundled text only.
+/// Unknown text is returned verbatim. This never rewrites storage or requests.
+String bundledTextInLanguage(String source, String language) =>
+    language == 'zh' ? (bundledChineseText[source] ?? source) : source;
+
+String bundledText(String source) => bundledTextInLanguage(
+  source,
+  'glaze_bundled_locale'.tr(),
+);
+
+/// A controller may show a Chinese rendering while its working item retains
+/// the original prompt. Only a real text edit should replace that original.
+String preserveUneditedBundledText(
+  String original,
+  String displayed,
+  String edited,
+) => edited == displayed ? original : edited;
