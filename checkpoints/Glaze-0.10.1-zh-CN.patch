@@ -0,0 +1,480 @@
+{
+    "categories": [
+        {
+            "id": "faq",
+            "label": "常见问题",
+            "terms": [
+                {
+                    "id": "faq-where-cards",
+                    "name": "在哪里获取角色卡？",
+                    "desc": "多个社区网站提供 SillyTavern 格式的[[character|角色]]卡。[Chub.ai](https://chub.ai)（Character Hub）是最大的角色卡库，可以直接搜索、预览并下载 .json 文件，随后导入 Glaze。若要获取 Janitor AI 的角色，可使用 [datacat.run](https://datacat.run) 将任意角色导出为角色卡文件，包括私有角色和禁用代理的角色。[Backyard.ai](https://backyard.ai) 也有可供下载的角色卡库。"
+                },
+                {
+                    "id": "faq-thinking-in-message",
+                    "name": "为什么模型在消息正文中思考？",
+                    "desc": "模型把推理（思维链）放在了回复正文中，而没有放入单独的区块。请参阅[[preset-reasoning|推理]]，启用“解析内联推理”，即可自动从 <think>...</think> 等标签中提取思考内容，并显示在单独的推理区块中。"
+                },
+                {
+                    "id": "faq-where-llm",
+                    "name": "在哪里找到大语言模型？",
+                    "desc": "你需要一个[[api|API 服务商]]，即提供 AI 模型访问权限的服务。注册后，你会获得 API 端点和密钥，将它们填入 Glaze 的 API 设置即可。"
+                },
+                {
+                    "id": "faq-censorship",
+                    "name": "模型在审查我的消息",
+                    "desc": "尝试使用合适的预设，例如内置预设中的 fawnie。请确保至少使用内联 CoT（预设中的额外思考功能）。即使使用相同模型，审查情况也可能因服务商而异。影响审查的不仅是聊天内容，预设中的所有数据都可能产生影响，包括你的[[persona|用户身份]]和[[character|角色]]卡。其中的性相关描述也可能触发模型的审查。"
+                },
+                {
+                    "id": "faq-which-models",
+                    "name": "应该使用哪些模型？",
+                    "desc": "以下选项适合不同偏好与预算。注重性价比：DeepSeek V3.2。折中选择：Gemini 3.1 Pro。旗舰模型：Claude Sonnet 4.6 / Opus 4.6。想尝试其他选择：GLM 5.1。其他模型通常不太值得关注，原因可能是上下文容量不足，或写作表现一般。"
+                }
+            ]
+        },
+        {
+            "id": "basics",
+            "label": "基础知识",
+            "terms": [
+                {
+                    "id": "llm",
+                    "name": "大语言模型",
+                    "alt": "AI，神经网络",
+                    "desc": "能够阅读和编写文本的 AI。它会查看整段对话，再逐个片段预测下一个词。示例：Gemini 3.1 Pro、Claude Sonnet 4.6、Deepseek V3.2。"
+                },
+                {
+                    "id": "token",
+                    "name": "词元",
+                    "desc": "AI 读写文本的最小单位，通常约相当于四分之三个英文单词。你输入的每条消息和收到的每次回复都会计入词元数。词元也有上限：对话过长时，最早的消息会被截去。词元越多，费用越高，回复越慢。"
+                },
+                {
+                    "id": "token-estimate",
+                    "name": "为什么词元统计有差异",
+                    "alt": "词元估算，分词器",
+                    "desc": "Glaze 会在本地统计[[token|词元]]，使用连接所对应模型家族的分词器：GPT-4o 及更新模型使用 OpenAI 的 o200k_base，其他主要模型家族使用各自公开的分词器。连接的“分词器”设置默认为“自动”，根据模型名称选择模型家族；无法从名称判断时使用 o200k_base。你也可以在“上下文大小”下手动选择。“提示词检查器”会显示所用的分词器。各分词器仅在首次需要时下载一次（1–5 MB）；下载完成前，Glaze 继续使用上一个分词器，首次启动时则按约每四个字符一个词元估算。Claude 3 及更新模型和 Gemini 未公开精确的分词器，因此相关统计只能作为规划用的估算值，可能存在百分之几的差异。实际计费请以服务商自己的用量页面为准。"
+                },
+                {
+                    "id": "context",
+                    "name": "上下文",
+                    "alt": "上下文窗口，上下文大小",
+                    "desc": "AI 一次能看到的最大[[token|词元]]数量，也就是它的工作记忆。Glaze 发送的所有内容，包括系统指令、[[preset|预设]]区块、[[lorebook|世界书]]条目、聊天历史以及新的回复，都必须容纳在这个窗口内。对话过长时，会裁剪较早的消息以保持在限制内。“上下文大小”在模型设置中指定，不得超过模型的最大值。"
+                },
+                {
